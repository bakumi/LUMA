<Window x:Class="LUMA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="760" d:DesignHeight="500"
        Title="LUMA"
        Width="760" Height="500"
        MinWidth="760" MinHeight="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#00000000"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowActivated="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        SourceInitialized="Window_SourceInitialized"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing">
    <Grid Background="#00000000">
        <!-- Compact Notch (Idle state at top edge) -->
        <Grid x:Name="CompactNotch" Width="208" Height="19"
              Panel.ZIndex="0"
              HorizontalAlignment="Center" VerticalAlignment="Top"
              SnapsToDevicePixels="True">
            <Button x:Name="CompactButton" Click="CompactButton_Click"
                    Style="{StaticResource CompactButtonStyle}" ToolTip="Открыть LUMA" Background="Blue" />
        </Grid>

        <!-- Dynamically Resizing Island Surface (on top of Compact Notch) -->
        <Grid x:Name="IslandSurface"
              Visibility="Collapsed"
              Width="540" Height="320"
              Panel.ZIndex="1"
              HorizontalAlignment="Center" VerticalAlignment="Top"
              IsHitTestVisible="False"
              RenderTransformOrigin="0.5,0"
              SizeChanged="IslandSurface_SizeChanged"
              SnapsToDevicePixels="True">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="IslandScale" ScaleX="0.385" ScaleY="0.059" />
            </Grid.RenderTransform>

            <!-- Dynamically calculated Curved Island Contour Path -->
            <Path x:Name="IslandPath"
                  Fill="{StaticResource IslandBackground}"
                  Stroke="#FF25252A" StrokeThickness="1" />

            <!-- Clipped Island Inner Content (Dynamically clipped to the same path geometry) -->
            <Grid x:Name="IslandClippedContent">
                <Grid.Clip>
                    <PathGeometry x:Name="IslandClipGeometry" />
                </Grid.Clip>

                <Grid x:Name="ExpandedContent" Opacity="0" Visibility="Collapsed" Margin="27,10,27,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Row 0: Tabs (hidden in standalone Player mode) -->
                        <RowDefinition Height="*" />    <!-- Row 1: Active Tab Panel Content -->
                    </Grid.RowDefinitions>

                    <!-- TOP TABS (exact tabs from reference photos, sitting directly on the island background) -->
                    <StackPanel x:Name="ExpandedTabsRow" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,10">
                        <Button x:Name="ControlsTabBtn" Content="Controls" Tag="controls" Style="{StaticResource ActiveTabButton}" Click="TabButton_Click" Margin="0,0,5,0" />
                        <Button x:Name="PlayerTabBtn" Content="Player" Tag="player" Style="{StaticResource TabButton}" Click="TabButton_Click" Margin="0,0,5,0" />
                        <Button x:Name="StatsTabBtn" Content="Stats" Tag="stats" Style="{StaticResource TabButton}" Click="TabButton_Click" Margin="0,0,5,0" />
                        <Button x:Name="AppsTabBtn" Content="Apps" Tag="apps" Style="{StaticResource TabButton}" Click="TabButton_Click" Margin="0,0,5,0" />
                        <Button x:Name="WallpaperTabBtn" Content="Wallpaper" Tag="wallpaper" Style="{StaticResource TabButton}" Click="TabButton_Click" Margin="0,0,5,0" />
                        <Button x:Name="PowerTabBtn" Content="Power" Tag="power" Style="{StaticResource TabButton}" Click="TabButton_Click" />
                    </StackPanel>

                    <!-- CONTENT PANELS CONTAINER -->
                    <Grid Grid.Row="1">
                        <!-- TAB 1: CONTROLS (Exact Hitodama Control Center layout from Photo 2, 540x320) -->
                        <Grid x:Name="ControlsPanel" Visibility="Visible">
                            <Grid.RenderTransform>
                                <TranslateTransform Y="0" />
                            </Grid.RenderTransform>

                            <!-- Sub-page 1: Main Controls View -->
                            <Grid x:Name="ControlsMainView">
                                <Grid.RenderTransform>
                                    <TranslateTransform X="0" />
                                </Grid.RenderTransform>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Row 0: Wi-Fi, Bluetooth, Audio -->
                                    <RowDefinition Height="Auto" /> <!-- Row 1: Night Light, Dark mode -->
                                    <RowDefinition Height="Auto" /> <!-- Row 2: Volume slider pill -->
                                    <RowDefinition Height="Auto" /> <!-- Row 3: Embedded Music Player -->
                                </Grid.RowDefinitions>

                            <!-- Row 0: 3 Quick Settings Cards -->
                            <Grid Grid.Row="0" Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Wi-Fi Card (Smooth Dual-Layer) -->
                                <Button x:Name="WifiCard" Grid.Column="0" Height="46" Style="{StaticResource QuickCardButton}" Margin="0,0,7,0" Click="WifiCard_Click">
                                    <Grid>
                                        <!-- Inactive Dark Layer -->
                                        <Border x:Name="WifiDarkLayer" Background="#FF1E1E22" BorderBrush="#FF2B2B30" BorderThickness="1" CornerRadius="14">
                                            <Grid Margin="10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="#FF2B2B30" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="11.5" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Wi-Fi" Foreground="#FFFFFFFF" FontSize="11.5" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="WifiSubtitleDark" Text="Off" Foreground="#FF8E8A93" FontSize="9.5" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8.5" Foreground="#FF8E8A93" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <!-- Active Orange Layer -->
                                        <Border x:Name="WifiOrangeLayer" Background="#FFFF8E5F" BorderBrush="#FFFF9E75" BorderThickness="1" CornerRadius="14" Opacity="0">
                                            <Grid Margin="10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#FF24120A" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Wi-Fi" Foreground="#FF24120A" FontSize="11.5" FontWeight="Bold" />
                                                    <TextBlock x:Name="WifiSubtitleOrange" Text="Connected" Foreground="#FF5E3320" FontSize="9.5" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8.5" Foreground="#FF5E3320" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Button>

                                <!-- Bluetooth Card (Smooth Dual-Layer) -->
                                <Button x:Name="BluetoothCard" Grid.Column="1" Height="46" Style="{StaticResource QuickCardButton}" Margin="0,0,7,0" Click="BluetoothCard_Click">
                                    <Grid>
                                        <!-- Inactive Dark Layer -->
                                        <Border x:Name="BluetoothDarkLayer" Background="#FF1E1E22" BorderBrush="#FF2B2B30" BorderThickness="1" CornerRadius="14">
                                            <Grid Margin="9,0,10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="#FF2B2B30" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="11.5" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Bluetooth" Foreground="#FFFFFFFF" FontSize="11.5" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="BluetoothSubtitleDark" Text="Off" Foreground="#FF8E8A93" FontSize="9.5" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8.5" Foreground="#FF8E8A93" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <!-- Active Orange Layer -->
                                        <Border x:Name="BluetoothOrangeLayer" Background="#FFFF8E5F" BorderBrush="#FFFF9E75" BorderThickness="1" CornerRadius="14" Opacity="0">
                                            <Grid Margin="10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#FF24120A" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Bluetooth" Foreground="#FF24120A" FontSize="11.5" FontWeight="Bold" />
                                                    <TextBlock x:Name="BluetoothSubtitleOrange" Text="On" Foreground="#FF5E3320" FontSize="9.5" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8.5" Foreground="#FF5E3320" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Button>

                                <!-- Audio Card (Smooth Dual-Layer) -->
                                <Button x:Name="AudioCard" Grid.Column="2" Height="46" Style="{StaticResource QuickCardButton}" Click="AudioCard_Click">
                                    <Grid>
                                        <!-- Inactive Dark Layer -->
                                        <Border x:Name="AudioDarkLayer" Background="#FF1E1E22" BorderBrush="#FF2B2B30" BorderThickness="1" CornerRadius="14">
                                            <Grid Margin="10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="#FF2B2B30" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="AudioIconDark" Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="11.5" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Audio" Foreground="#FFFFFFFF" FontSize="11.5" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="AudioSubtitleDark" Text="Speakers" Foreground="#FF8E8A93" FontSize="9.5" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8.5" Foreground="#FF8E8A93" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <!-- Active Orange Layer -->
                                        <Border x:Name="AudioOrangeLayer" Background="#FFFF8E5F" BorderBrush="#FFFF9E75" BorderThickness="1" CornerRadius="14" Opacity="1">
                                            <Grid Margin="10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="AudioIconOrange" Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#FF24120A" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Audio" Foreground="#FF24120A" FontSize="11.5" FontWeight="Bold" />
                                                    <TextBlock x:Name="AudioSubtitleOrange" Text="Speakers" Foreground="#FF5E3320" FontSize="9.5" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8.5" Foreground="#FF5E3320" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Button>
                            </Grid>

                            <!-- Row 1: Night Light (Dark) & Dark mode (Active Orange) -->
                            <Grid Grid.Row="1" Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Night Light Card (Smooth Dual-Layer) -->
                                <Button x:Name="NightLightCard" Grid.Column="0" Height="46" Style="{StaticResource QuickCardButton}" Margin="0,0,7,0" Click="NightLightCard_Click">
                                    <Grid>
                                        <!-- Inactive Dark Layer -->
                                        <Border x:Name="NightLightDarkLayer" Background="#FF1E1E22" BorderBrush="#FF2B2B30" BorderThickness="1" CornerRadius="14">
                                            <Grid Margin="9,0,10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="#FF2B2B30" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="11.5" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Night Light" Foreground="#FFFFFFFF" FontSize="11.5" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="NightLightSubtitleDark" Text="Off" Foreground="#FF8E8A93" FontSize="9.5" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8.5" Foreground="#FF8E8A93" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <!-- Active Orange Layer -->
                                        <Border x:Name="NightLightOrangeLayer" Background="#FFFF8E5F" BorderBrush="#FFFF9E75" BorderThickness="1" CornerRadius="14" Opacity="0">
                                            <Grid Margin="10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#FF24120A" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Night Light" Foreground="#FF24120A" FontSize="11.5" FontWeight="Bold" />
                                                    <TextBlock x:Name="NightLightSubtitleOrange" Text="On" Foreground="#FF5E3320" FontSize="9.5" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8.5" Foreground="#FF5E3320" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Button>

                                <!-- Dark mode Card (Smooth Dual-Layer) -->
                                <Button x:Name="DarkModeCard" Grid.Column="1" Height="46" Style="{StaticResource QuickCardButton}" Click="DarkModeCard_Click">
                                    <Grid>
                                        <!-- Inactive Dark Layer -->
                                        <Border x:Name="DarkModeDarkLayer" Background="#FF1E1E22" BorderBrush="#FF2B2B30" BorderThickness="1" CornerRadius="14">
                                            <Grid Margin="10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="#FF2B2B30" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE793;" FontFamily="Segoe MDL2 Assets" FontSize="11.5" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Dark mode" Foreground="#FFFFFFFF" FontSize="11.5" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="DarkModeSubtitleDark" Text="Off" Foreground="#FF8E8A93" FontSize="9.5" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <!-- Active Orange Layer -->
                                        <Border x:Name="DarkModeOrangeLayer" Background="#FFFF8E5F" BorderBrush="#FFFF9E75" BorderThickness="1" CornerRadius="14" Opacity="1">
                                            <Grid Margin="10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE793;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#FF24120A" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Dark mode" Foreground="#FF24120A" FontSize="11.5" FontWeight="Bold" />
                                                    <TextBlock x:Name="DarkModeSubtitleOrange" Text="On" Foreground="#FF5E3320" FontSize="9.5" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Button>
                            </Grid>

                            <!-- Row 2: Volume Slider Pill (Interactive orange bar with speaker icon & percentage) -->
                            <Border x:Name="VolumeContainer" Grid.Row="2" Height="38" CornerRadius="19"
                                    Background="#FF1F1F21" BorderBrush="#FF2B2B30" BorderThickness="1"
                                    Cursor="Hand" Margin="0,0,0,7" ClipToBounds="True"
                                    PreviewMouseDown="VolumeContainer_MouseDown"
                                    PreviewMouseMove="VolumeContainer_MouseMove"
                                    PreviewMouseUp="VolumeContainer_MouseUp"
                                    MouseWheel="VolumeContainer_MouseWheel"
                                    SizeChanged="VolumeContainer_SizeChanged">
                                <Grid>
                                    <Border x:Name="VolumeFill" Background="#FFFF8E5F" CornerRadius="19" HorizontalAlignment="Left" Width="140" />
                                    <DockPanel LastChildFill="False" VerticalAlignment="Center" Margin="12,0,14,0" IsHitTestVisible="False">
                                        <TextBlock x:Name="VolumeSpeakerIcon" Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="13.5" Foreground="#FF24120A" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                        <TextBlock x:Name="VolumeText" Text="28%" Foreground="#FFFFFFFF" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" DockPanel.Dock="Right" />
                                    </DockPanel>
                                </Grid>
                            </Border>

                            <!-- Row 3: Embedded Music Player Card (Photo 2 bottom) -->
                            <Border Grid.Row="3" Background="#FF161619" BorderBrush="#FF252528" BorderThickness="1" CornerRadius="15" Padding="12,9">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Subheader: ◄ Speakers -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5" Cursor="Hand" MouseDown="Speakers_MouseDown" ToolTip="Открыть отдельный компактный плеер (Photo 1)">
                                        <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="9.5" Foreground="#FF8E8A93" VerticalAlignment="Center" />
                                        <TextBlock Text="Speakers" Foreground="#FF8E8A93" FontSize="10.5" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Main track row -->
                                    <Grid Grid.Row="1" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Album Art -->
                                        <Border x:Name="EmbeddedAlbumBorder" Grid.Column="0" Width="42" Height="42" CornerRadius="9" Margin="0,0,10,0" Cursor="Hand" MouseDown="AlbumArt_MouseDown" ToolTip="Компактный плеер" ClipToBounds="True">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FF6E4776" Offset="0" />
                                                    <GradientStop Color="#FF3D2752" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Image x:Name="EmbeddedAlbumImage" Stretch="UniformToFill" Visibility="Collapsed" />
                                        </Border>

                                        <!-- Track Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="TrackTitle" Text="lofi beats to study and relax" Foreground="#FFFFFFFF" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="TrackArtist" Text="lofi radio" Foreground="#FF8E8A93" FontSize="10.5" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Controls: Prev, Play, Next -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Width="28" Height="28" Style="{StaticResource RoundMediaButton}" Margin="0,0,5,0" Click="PlayerPrev_Click" ToolTip="Предыдущий трек">
                                                <TextBlock Text="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="12.5" Foreground="#FFA8A8B0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Button>
                                            <Button x:Name="PlayPauseButton" Width="34" Height="34" Style="{StaticResource PrimaryPlayButton}" Margin="0,0,5,0" Click="PlayerPlayPause_Click" ToolTip="Воспроизведение / Пауза">
                                                <TextBlock x:Name="PlayPauseIcon" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12.5" Foreground="#FF121214" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                                            </Button>
                                            <Button Width="28" Height="28" Style="{StaticResource RoundMediaButton}" Click="PlayerNext_Click" ToolTip="Следующий трек">
                                                <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="12.5" Foreground="#FFA8A8B0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Progress Timeline -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock x:Name="CurrentTimeText" Grid.Column="0" Text="00:00:57" Width="52" TextAlignment="Left" Foreground="#FF8E8A93" FontSize="9.5" VerticalAlignment="Center" />

                                        <Grid x:Name="ProgressTrackContainer" Grid.Column="1" Height="14" Margin="9,0" Cursor="Hand"
                                              PreviewMouseDown="ProgressTrack_MouseDown"
                                              SizeChanged="ProgressTrack_SizeChanged">
                                            <Border Height="2.5" CornerRadius="1.25" Background="#FF28282C" VerticalAlignment="Center" />
                                            <Border x:Name="ProgressFill" Height="2.5" CornerRadius="1.25" Background="#FFFF8E5F" HorizontalAlignment="Left" Width="60" VerticalAlignment="Center" />
                                            <Border x:Name="ProgressScrubber" Width="9" Height="5" CornerRadius="2.5" Background="#FFFF8E5F" HorizontalAlignment="Left" Margin="56,0,0,0" VerticalAlignment="Center" />
                                        </Grid>

                                        <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="01:02:15" Width="52" TextAlignment="Right" Foreground="#FF8E8A93" FontSize="9.5" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                            </Grid>

                            <!-- Sub-page 2: Controls Detail View (Bluetooth devices, Audio endpoints, Wi-Fi) -->
                            <Grid x:Name="ControlsDetailView" Visibility="Collapsed" Opacity="0">
                                <Grid.RenderTransform>
                                    <TranslateTransform X="20" />
                                </Grid.RenderTransform>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Header -->
                                    <RowDefinition Height="*" />    <!-- Scrollable device list -->
                                    <RowDefinition Height="Auto" /> <!-- Bottom settings action -->
                                </Grid.RowDefinitions>

                                <!-- Header Bar: [ < Controls ]   Title   [ ↻ Refresh ] -->
                                <DockPanel Grid.Row="0" Margin="2,0,2,10" LastChildFill="False">
                                    <Button x:Name="DetailBackBtn" DockPanel.Dock="Left" Click="DetailBack_Click"
                                            Background="#FF1E1E22" BorderBrush="#FF28282C" Foreground="#FFFFFFFF" FontWeight="SemiBold" FontSize="11"
                                            Padding="10,4" BorderThickness="1" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="9" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#FF8E8A93" />
                                                        <TextBlock Text="Controls" FontSize="10.5" VerticalAlignment="Center" Foreground="#FFFFFFFF" />
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <TextBlock x:Name="DetailTitleText" Text="Bluetooth" DockPanel.Dock="Left" Foreground="#FFFFFFFF" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,0,0" />

                                    <Button x:Name="DetailRefreshBtn" DockPanel.Dock="Right" Width="28" Height="28" Style="{StaticResource RoundMediaButton}" ToolTip="Обновить" Click="DetailRefresh_Click">
                                        <TextBlock x:Name="DetailRefreshIcon" Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#FF8E8A93" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                </DockPanel>

                                <!-- Device / Network List Area (smooth scrolling without harsh white scrollbar) -->
                                <ScrollViewer Grid.Row="1" Height="185" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
                                    <StackPanel x:Name="DetailContentContainer" Margin="2,0,2,10" />
                                </ScrollViewer>

                                <!-- Bottom Action Button -->
                                <Button x:Name="DetailBottomBtn" Grid.Row="2" Height="30" Margin="2,8,2,0" Style="{StaticResource QuickCardButton}" Click="DetailBottomBtn_Click">
                                    <Border Background="#FF1E1E22" BorderBrush="#FF28282C" BorderThickness="1" CornerRadius="10">
                                        <TextBlock x:Name="DetailBottomBtnText" Text="Open Windows Settings" Foreground="#FFFF8E5F" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Button>
                            </Grid>
                        </Grid>

                        <!-- TAB 2: POWER (Photo 5: 4 compact rounded cards side by side, 540x140) -->
                        <Grid x:Name="PowerPanel" Visibility="Collapsed">
                            <Grid.RenderTransform>
                                <TranslateTransform Y="0" />
                            </Grid.RenderTransform>
                            <UniformGrid Columns="4" VerticalAlignment="Center" Margin="0,2,0,4">
                                <Button Style="{StaticResource PowerCardButton}" Tag="lock" Click="PowerAction_Click" ToolTip="Заблокировать" Margin="0,0,4,0">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#FFFFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                        <TextBlock Text="Lock" Foreground="#FFFFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PowerCardButton}" Tag="sleep" Click="PowerAction_Click" ToolTip="Режим сна" Margin="4,0,4,0">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#FFFFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                        <TextBlock Text="Sleep" Foreground="#FFFFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PowerCardButton}" Tag="restart" Click="PowerAction_Click" ToolTip="Перезагрузка" Margin="4,0,4,0">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#FFFFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                        <TextBlock Text="Restart" Foreground="#FFFFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PowerCardButton}" Tag="shutdown" Click="PowerAction_Click" ToolTip="Выключение" Margin="4,0,0,0">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#FFFFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                        <TextBlock Text="Shut down" Foreground="#FFFFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </Grid>

                        <!-- TAB 3: STATS (Photo 3: 3 circular gauges + Top Apps + Speed test, 680x275) -->
                        <Grid x:Name="StatsPanel" Visibility="Collapsed">
                            <Grid.RenderTransform>
                                <TranslateTransform Y="0" />
                            </Grid.RenderTransform>
                            <Grid Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.72*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left section: 3 Circular Gauges + 3 Bottom Pills -->
                                <Grid Grid.Column="0" Margin="0,0,8,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: 3 Circular Gauge Cards -->
                                    <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,7" VerticalAlignment="Top">
                                        <!-- CPU -->
                                        <Border Background="#FF161619" BorderBrush="#FF252528" BorderThickness="1" CornerRadius="15" Padding="10,12" Margin="0,0,5,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Grid Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,8">
                                                    <Ellipse Stroke="#FF24242A" StrokeThickness="5" Width="52" Height="52" />
                                                    <Path x:Name="CpuGaugeArc" Stroke="#FFFF8E5F" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    <TextBlock x:Name="CpuGaugePercent" Text="37%" Foreground="#FFFFFFFF" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="CPU" Foreground="#FFFFFFFF" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" />
                                                <TextBlock x:Name="CpuModelName" Text="AMD Ryzen 7" Foreground="#FF8E8A93" FontSize="9.5" HorizontalAlignment="Center" Margin="0,2,0,6" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Border Background="#FF222226" CornerRadius="6" Padding="6,2" Margin="0,0,4,0">
                                                        <TextBlock x:Name="CpuSpeedBadge" Text="4.2 GHz" Foreground="#FF8E8A93" FontSize="8.5" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Background="#FF222226" CornerRadius="6" Padding="6,2">
                                                        <TextBlock x:Name="CpuProcBadge" Text="229 proc" Foreground="#FF8E8A93" FontSize="8.5" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- GPU -->
                                        <Border Background="#FF161619" BorderBrush="#FF252528" BorderThickness="1" CornerRadius="15" Padding="10,12" Margin="0,0,5,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Grid Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,8">
                                                    <Ellipse Stroke="#FF24242A" StrokeThickness="5" Width="52" Height="52" />
                                                    <Path x:Name="GpuGaugeArc" Stroke="#FFC4A7FF" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    <TextBlock x:Name="GpuGaugePercent" Text="12%" Foreground="#FFFFFFFF" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="GPU" Foreground="#FFFFFFFF" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" />
                                                <TextBlock Text="NVIDIA GeForce" Foreground="#FF8E8A93" FontSize="9.5" HorizontalAlignment="Center" Margin="0,2,0,6" />
                                                <Border Background="#FF222226" CornerRadius="6" Padding="6,2" HorizontalAlignment="Center">
                                                    <TextBlock Text="2.1 / 8.0 GB" Foreground="#FF8E8A93" FontSize="8.5" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- RAM -->
                                        <Border Background="#FF161619" BorderBrush="#FF252528" BorderThickness="1" CornerRadius="15" Padding="10,12">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Grid Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,8">
                                                    <Ellipse Stroke="#FF24242A" StrokeThickness="5" Width="52" Height="52" />
                                                    <Path x:Name="RamGaugeArc" Stroke="#FF85E05B" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    <TextBlock x:Name="RamGaugePercent" Text="61%" Foreground="#FFFFFFFF" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="RAM" Foreground="#FFFFFFFF" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" />
                                                <TextBlock x:Name="RamUsageText" Text="19.4 / 31.9 GB" Foreground="#FF8E8A93" FontSize="9.5" HorizontalAlignment="Center" Margin="0,2,0,6" />
                                                <Border Background="#FF222226" CornerRadius="6" Padding="6,2" HorizontalAlignment="Center">
                                                    <TextBlock x:Name="RamFreeText" Text="12.5 GB free" Foreground="#FF8E8A93" FontSize="8.5" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <!-- Row 1: 3 Mini Horizontal Pills (Aligned with bottom of Internet Speed) -->
                                    <UniformGrid Grid.Row="1" Columns="3" VerticalAlignment="Bottom">
                                        <Border Background="#FF161619" BorderBrush="#FF252528" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,5,0">
                                            <StackPanel>
                                                <TextBlock Text="DISK C:" Foreground="#FF8E8A93" FontSize="8" FontWeight="Bold" />
                                                <TextBlock x:Name="DiskQuickText" Text="412 / 931 GB" Foreground="#FFFFFFFF" FontSize="11" FontWeight="Bold" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#FF161619" BorderBrush="#FF252528" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,5,0">
                                            <StackPanel>
                                                <TextBlock Text="NETWORK" Foreground="#FF8E8A93" FontSize="8" FontWeight="Bold" />
                                                <TextBlock x:Name="NetworkQuickText" Text="&#x2193; 1.2 MB/s  &#x2191; 300 KB/s" Foreground="#FFFFFFFF" FontSize="9.5" FontWeight="Bold" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#FF161619" BorderBrush="#FF252528" BorderThickness="1" CornerRadius="12" Padding="10,8">
                                            <StackPanel>
                                                <TextBlock Text="UP FOR" Foreground="#FF8E8A93" FontSize="8" FontWeight="Bold" />
                                                <TextBlock x:Name="UptimeQuickText" Text="5 h 12 m" Foreground="#FFFFFFFF" FontSize="11" FontWeight="Bold" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </Grid>

                                <!-- Right section: Top Apps Card + Internet Speed Card -->
                                <StackPanel Grid.Column="1">
                                    <!-- Top Apps Card -->
                                    <Border Background="#FF161619" BorderBrush="#FF252528" BorderThickness="1" CornerRadius="14" Padding="12,10" Margin="0,0,0,7">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                                <TextBlock x:Name="TopAppsHeader" Text="Top apps &#xB7; RAM" Foreground="#FF8E8A93" FontSize="9" FontWeight="Bold" DockPanel.Dock="Left" />
                                                <TextBlock x:Name="TopAppsSortBtn" Text="CPU &#x21C4;" Foreground="#FFFF8E5F" FontSize="9" FontWeight="Bold" DockPanel.Dock="Right" Cursor="Hand" MouseDown="TopAppsSort_Click" ToolTip="Переключить сортировку по CPU / RAM" />
                                            </DockPanel>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8" Background="#FF2B2B32" Margin="0,0,6,0">
                                                    <TextBlock x:Name="TopApp1Icon" Text="G" Foreground="#FFFFFFFF" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock x:Name="TopApp1Name" Grid.Column="1" Text="Google Chrome" Foreground="#FFFFFFFF" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TopApp1Mem" Grid.Column="2" Text="1.4 GB" Foreground="#FF8E8A93" FontSize="10" VerticalAlignment="Center" />
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8" Background="#FF2B2B32" Margin="0,0,6,0">
                                                    <TextBlock x:Name="TopApp2Icon" Text="V" Foreground="#FFFFFFFF" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock x:Name="TopApp2Name" Grid.Column="1" Text="VS Code" Foreground="#FFFFFFFF" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TopApp2Mem" Grid.Column="2" Text="820 MB" Foreground="#FF8E8A93" FontSize="10" VerticalAlignment="Center" />
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8" Background="#FF2B2B32" Margin="0,0,6,0">
                                                    <TextBlock x:Name="TopApp3Icon" Text="S" Foreground="#FFFFFFFF" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock x:Name="TopApp3Name" Grid.Column="1" Text="Spotify" Foreground="#FFFFFFFF" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TopApp3Mem" Grid.Column="2" Text="410 MB" Foreground="#FF8E8A93" FontSize="10" VerticalAlignment="Center" />
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8" Background="#FF2B2B32" Margin="0,0,6,0">
                                                    <TextBlock x:Name="TopApp4Icon" Text="D" Foreground="#FFFFFFFF" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock x:Name="TopApp4Name" Grid.Column="1" Text="Discord" Foreground="#FFFFFFFF" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TopApp4Mem" Grid.Column="2" Text="300 MB" Foreground="#FF8E8A93" FontSize="10" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Speed Test Card -->
                                    <Border Background="#FF161619" BorderBrush="#FF252528" BorderThickness="1" CornerRadius="14" Padding="12,8">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock Text="Internet speed" Foreground="#FF8E8A93" FontSize="8.5" FontWeight="Bold" DockPanel.Dock="Left" />
                                                <TextBlock x:Name="SpeedLastTimeText" Text="last: 5 min ago &#xB7; Local" Foreground="#FF8E8A93" FontSize="8" DockPanel.Dock="Right" />
                                            </DockPanel>
                                            <DockPanel Margin="0,3,0,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="SpeedDownText" Text="85" Foreground="#FFFFFFFF" FontSize="16" FontWeight="Bold" />
                                                    <TextBlock Text=" Mbps &#x2193;" Foreground="#FF8E8A93" FontSize="9" VerticalAlignment="Bottom" Margin="2,0,8,2" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                    <TextBlock x:Name="SpeedUpText" Text="42" Foreground="#FFFFFFFF" FontSize="16" FontWeight="Bold" />
                                                    <TextBlock Text=" Mbps &#x2191;" Foreground="#FF8E8A93" FontSize="9" VerticalAlignment="Bottom" Margin="2,0,0,2" />
                                                </StackPanel>
                                            </DockPanel>
                                            <Button x:Name="SpeedTestButton" Height="26" Style="{StaticResource QuickCardOrange}" Click="SpeedTest_Click">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock x:Name="SpeedTestIcon" Text="&#x25B6;" FontSize="8.5" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                    <TextBlock x:Name="SpeedTestBtnText" Text="Run speed test" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- TAB 4: APPS (Photo 4: Search bar, starred, recent, applications list, 520x435) -->
                        <Grid x:Name="AppsPanel" Visibility="Collapsed">
                            <Grid.RenderTransform>
                                <TranslateTransform Y="0" />
                            </Grid.RenderTransform>
                            <StackPanel Margin="0,2,0,0">
                                <!-- Search bar with Win+A badge -->
                                <Border Height="36" CornerRadius="18" Background="#FF161619" BorderBrush="#FF252528" BorderThickness="1" Padding="12,0" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12.5" Foreground="#FF8E8A93" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="SearchPlaceholder" Text="Search apps, files and snippets..." Foreground="#FF8E8A93" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False" />
                                            <TextBox x:Name="AppSearchBox" Background="Transparent" BorderThickness="0" Foreground="#FFFFFFFF" CaretBrush="#FFFFFFFF" FontSize="11" VerticalAlignment="Center" TextChanged="AppSearchBox_TextChanged" KeyDown="AppSearchBox_KeyDown" />
                                        </Grid>
                                        <Border Grid.Column="2" Background="#FF222226" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="Win+A" Foreground="#FF8E8A93" FontSize="8.5" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Real Search History Tags (⚡ <query>) -->
                                <StackPanel x:Name="QuickTagsContainer" Orientation="Horizontal" Margin="0,0,0,8" />

                                <!-- Scrollable Real Applications & Files Container -->
                                <ScrollViewer Height="335" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
                                    <StackPanel x:Name="AppsListContainer" />
                                </ScrollViewer>
                                <TextBlock x:Name="NoAppsFoundText" Text="No matching applications or files found" Foreground="#FF8E8A93" FontSize="11" HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>

                        <!-- TAB 2: PLAYER (Remade from Today tab; compact height, matches Photo 1) -->
                        <Grid x:Name="PlayerPanel" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,2,0,0">
                            <Grid.RenderTransform>
                                <TranslateTransform Y="0" />
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Album Art + Track Info + Compact View Toggle -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Album Art (Safely below top curve, zero clipping) -->
                                <Border x:Name="StandaloneAlbumBorder" Grid.Column="0" Width="38" Height="38" CornerRadius="8" Margin="0,0,10,0" Cursor="Hand" MouseDown="CompactPlayer_ExpandClick" ToolTip="Переключить компактный вид" ClipToBounds="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF6E4776" Offset="0" />
                                            <GradientStop Color="#FF3D2752" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Image x:Name="StandaloneAlbumImage" Stretch="UniformToFill" Visibility="Collapsed" />
                                </Border>

                                <!-- Track Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="PlayerStandaloneTitle" Text="lofi beats to study and relax" Foreground="#FFFFFFFF" FontSize="12.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="PlayerStandaloneArtist" Text="lofi radio" Foreground="#FF8E8A93" FontSize="10" Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- Expand / Collapse standalone view button -->
                                <Button Grid.Column="2" Width="26" Height="26" Style="{StaticResource RoundMediaButton}" ToolTip="Переключить компактный вид (Фото 1)" Click="CompactPlayer_ExpandClick">
                                    <TextBlock x:Name="PlayerModeIcon" Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#FF8E8A93" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </Grid>

                            <!-- Row 1: Timeline -->
                            <Grid Grid.Row="1" Margin="0,3,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="StandaloneCurrentTime" Grid.Column="0" Text="00:00:48" Width="50" TextAlignment="Left" Foreground="#FF8E8A93" FontSize="9" VerticalAlignment="Center" />

                                <Grid x:Name="StandaloneProgressContainer" Grid.Column="1" Height="14" Margin="10,0" Cursor="Hand"
                                      PreviewMouseDown="StandaloneProgress_MouseDown"
                                      SizeChanged="StandaloneProgress_SizeChanged">
                                    <Border Height="2.5" CornerRadius="1.25" Background="#FF28282C" VerticalAlignment="Center" />
                                    <Border x:Name="StandaloneProgressFill" Height="2.5" CornerRadius="1.25" Background="#FFFFFFFF" HorizontalAlignment="Left" Width="60" VerticalAlignment="Center" />
                                    <Border x:Name="StandaloneProgressScrubber" Width="6" Height="6" CornerRadius="3" Background="#FFFFFFFF" HorizontalAlignment="Left" Margin="57,0,0,0" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock x:Name="StandaloneTotalTime" Grid.Column="2" Text="01:02:15" Width="50" TextAlignment="Right" Foreground="#FF8E8A93" FontSize="9" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Row 2: Controls (|◄   ❚❚   ►|) with smooth hover effects -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <Button Width="28" Height="28" Style="{StaticResource RoundMediaButton}" Margin="0,0,20,0" Click="PlayerPrev_Click" ToolTip="Предыдущий трек">
                                    <TextBlock Text="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                                <Button Width="32" Height="32" Style="{StaticResource RoundMediaButton}" Margin="0,0,20,0" Click="PlayerPlayPause_Click" ToolTip="Воспроизведение / Пауза">
                                    <TextBlock x:Name="StandalonePlayIcon" Text="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                                <Button Width="28" Height="28" Style="{StaticResource RoundMediaButton}" Click="PlayerNext_Click" ToolTip="Следующий трек">
                                    <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- TAB 6: WALLPAPER (Exact Photo match: Cover Flow carousel + Subheader) -->
                        <Grid x:Name="WallpaperPanel" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,2,0,0">
                            <Grid.RenderTransform>
                                <TranslateTransform Y="0" />
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Row 0: Subheader (Recent, My folder, 5 pictures, folder icon) -->
                                <RowDefinition Height="Auto" /> <!-- Row 1: 5-Card Cover Flow Carousel -->
                            </Grid.RowDefinitions>

                            <!-- Subheader Row -->
                            <DockPanel Grid.Row="0" Margin="4,0,4,12" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Recent Pill (Active Orange) -->
                                    <Button x:Name="WallpaperRecentBtn" Content="Recent" Click="WallpaperRecent_Click"
                                            Background="#FFFF8E5F" Foreground="#FF24120A" FontWeight="Bold" FontSize="11"
                                            Padding="14,5" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- My folder Pill -->
                                    <Button x:Name="WallpaperFolderBtn" Content="My folder" Click="WallpaperFolder_Click"
                                            Background="#FF1E1E22" BorderBrush="#FF28282C" Foreground="#FFFFFFFF" FontWeight="SemiBold" FontSize="11"
                                            Padding="14,5" BorderThickness="1" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <TextBlock x:Name="WallpaperCountText" Text="5 pictures" Foreground="#FF8E8A93" FontSize="10.5" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>

                                <!-- Right: Folder Browser Icon Button -->
                                <Button x:Name="WallpaperBrowseBtn" DockPanel.Dock="Right" Width="30" Height="30" Style="{StaticResource QuickCardButton}" ToolTip="Выбрать папку или обои..." Click="WallpaperBrowse_Click">
                                    <Border Background="#FF1E1E22" BorderBrush="#FF28282C" BorderThickness="1" CornerRadius="8">
                                        <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="12.5" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Button>
                            </DockPanel>

                            <!-- Carousel Row: 5 Cards with elegant harmonious presentation -->
                            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Card 0: Far-Left Preview -->
                                    <Border x:Name="WallCard0" Width="72" Height="124" Margin="0,0,7,0" CornerRadius="12" Cursor="Hand" ClipToBounds="True" Opacity="0.55" MouseDown="WallCard_MouseDown" Tag="0">
                                        <Grid>
                                            <Image x:Name="WallImg0" Stretch="UniformToFill" />
                                            <Border Background="#40000000" />
                                        </Grid>
                                    </Border>

                                    <!-- Card 1: Mid-Left Preview -->
                                    <Border x:Name="WallCard1" Width="82" Height="128" Margin="0,0,9,0" CornerRadius="13" Cursor="Hand" ClipToBounds="True" Opacity="0.75" MouseDown="WallCard_MouseDown" Tag="1">
                                        <Grid>
                                            <Image x:Name="WallImg1" Stretch="UniformToFill" />
                                            <Border Background="#25000000" />
                                        </Grid>
                                    </Border>

                                    <!-- Card 2: Center Active (Wide Landscape with Glowing Border & Frosted Bottom Pill) -->
                                    <Border x:Name="WallCard2" Width="248" Height="136" Margin="0,0,9,0" CornerRadius="15" Cursor="Hand" ClipToBounds="True"
                                            BorderBrush="#FFFF8E5F" BorderThickness="1.5" MouseDown="WallCard_MouseDown" Tag="2">
                                        <Grid>
                                            <Image x:Name="WallImg2" Stretch="UniformToFill" />
                                            <Border x:Name="WallActiveIndicator" VerticalAlignment="Bottom" Height="28" Background="#D8111115" CornerRadius="0,0,14,14">
                                                <DockPanel Margin="10,0" LastChildFill="False">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                                        <TextBlock Text="&#xE7B7;" FontFamily="Segoe MDL2 Assets" FontSize="10.5" Foreground="#FFFF8E5F" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBlock x:Name="WallTitleText" Text="Autumn Dolomites" Foreground="#FFFFFFFF" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Border x:Name="WallStatusBadge" Background="#35FF8E5F" CornerRadius="6" Padding="6,2" VerticalAlignment="Center" DockPanel.Dock="Right">
                                                        <TextBlock x:Name="WallStatusText" Text="&#x2713; Active" Foreground="#FFFF8E5F" FontSize="9" FontWeight="Bold" />
                                                    </Border>
                                                </DockPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Card 3: Mid-Right Preview -->
                                    <Border x:Name="WallCard3" Width="82" Height="128" Margin="0,0,7,0" CornerRadius="13" Cursor="Hand" ClipToBounds="True" Opacity="0.75" MouseDown="WallCard_MouseDown" Tag="3">
                                        <Grid>
                                            <Image x:Name="WallImg3" Stretch="UniformToFill" />
                                            <Border Background="#25000000" />
                                        </Grid>
                                    </Border>

                                    <!-- Card 4: Far-Right Preview -->
                                    <Border x:Name="WallCard4" Width="72" Height="124" CornerRadius="12" Cursor="Hand" ClipToBounds="True" Opacity="0.55" MouseDown="WallCard_MouseDown" Tag="4">
                                        <Grid>
                                            <Image x:Name="WallImg4" Stretch="UniformToFill" />
                                            <Border Background="#40000000" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- CONFIRMATION OVERLAY FOR POWER ACTIONS -->
                    <Grid x:Name="ConfirmationOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#C8000000">
                        <Border Width="340" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FF17171B" BorderBrush="#FF39393F" BorderThickness="1" CornerRadius="20" Padding="20">
                            <StackPanel>
                                <Border Width="38" Height="38" CornerRadius="13" Background="#FF2B211D" HorizontalAlignment="Left" Margin="0,0,0,12">
                                    <TextBlock x:Name="ConfirmationIcon" Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="ConfirmationTitle" Text="Подтвердите действие" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="ConfirmationMessage" Text="Это действие повлияет на работу компьютера." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,6,0,18" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Назад" Click="DismissConfirmation_Click" Style="{StaticResource TabButton}" Margin="0,0,8,0" />
                                    <Button x:Name="ConfirmActionButton" Content="Продолжить" Click="ConfirmAction_Click" Style="{StaticResource ConfirmButton}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
