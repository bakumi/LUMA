<Window x:Class="LUMA.TranscriptionBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LUMA Voice Dictation"
        Width="740" Height="64"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Grid Background="Transparent">
        <!-- Floating Pill Container (Photo 1 reference match) -->
        <Border x:Name="PillBorder" Background="#F4111115" BorderBrush="#FF2B2B33" BorderThickness="1"
                CornerRadius="28" Margin="10,4,10,6" SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.5" />
            </Border.Effect>

            <Grid Margin="20,0,14,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- "YOU" Badge -->
                <TextBlock Grid.Column="0" Text="YOU" Foreground="#FF8E8A93" FontSize="10.5"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0" />

                <!-- Text Streaming Container -->
                <Grid Grid.Column="1" VerticalAlignment="Center" ClipToBounds="True" Margin="0,0,14,0">
                    <!-- Placeholder: "Слушаю вас..." -->
                    <TextBlock x:Name="PlaceholderTextBlock" Text="Слушаю вас..."
                               Foreground="#FF8E8A93" FontSize="13.5" FontWeight="Normal"
                               VerticalAlignment="Center" />

                    <!-- Streaming Words Container -->
                    <ScrollViewer x:Name="WordsScrollViewer"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  VerticalAlignment="Center">
                        <StackPanel x:Name="WordsContainer" Orientation="Horizontal" VerticalAlignment="Center" />
                    </ScrollViewer>
                </Grid>

                <!-- Send Button: Sleek Round Arrow Button -->
                <Border x:Name="SendButton" Grid.Column="2" Width="34" Height="34" CornerRadius="17"
                        Background="#FFFF8E5F" Cursor="Hand"
                        MouseDown="SendBtn_MouseDown" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#FF8E5F" BlurRadius="10" ShadowDepth="0" Opacity="0.35" />
                    </Border.Effect>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FFFF8E5F" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFFFA882" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Path Data="M 2,7 L 12,7 M 7.5,2.5 L 12,7 L 7.5,11.5"
                          Stroke="#FF0D0D12" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
